# 이 파일을 .env로 복사해 실제 값을 채웁니다.
#   cp .env.example .env
#
# .env는 커밋되지 않습니다 (.gitignore). 비밀 값은 이 파일에 넣지 마세요.

# ── 필수 ────────────────────────────────────────────────
# 빠지면 애플리케이션과 시드가 기동에 실패합니다.
DATABASE_URL="postgresql://fad:CHANGE_ME@localhost:5432/fad?schema=public"

# 세션 서명용 비밀키. 반드시 교체하세요.
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="CHANGE_ME_32_BYTES_HEX"

# ── 선택 ────────────────────────────────────────────────
# docker-compose로 PostgreSQL을 띄울 때만 사용합니다.
POSTGRES_USER="fad"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="fad"

# 시드 데모 계정 5종의 공통 비밀번호 (BR-U1-025)
# ⚠️ 로컬 PoC 전용입니다. 실제 운영에 쓸 수 없습니다.
SEED_PASSWORD="CHANGE_ME"
